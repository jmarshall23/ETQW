    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "ETQW Release",
      "configurePreset": "vs2022-win32",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "debug",
      "displayName": "ETQW Debug",
      "configurePreset": "vs2022-win32",
      "configuration": "Debug",
      "jobs": 8
    }
  ]
}
