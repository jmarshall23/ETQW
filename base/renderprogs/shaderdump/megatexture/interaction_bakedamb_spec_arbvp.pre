!!ARBvp1.0

		
		PARAM  __mvp[4]={state.matrix.mvp};
DP4 result.position.x, __mvp[0], vertex.position;
DP4 result.position.y, __mvp[1], vertex.position;
DP4 result.position.z, __mvp[2], vertex.position;
DP4 result.position.w, __mvp[3], vertex.position;
#replace texCoordAttrib with _texCoordAttrib
TEMP _texCoordAttrib;
MUL _texCoordAttrib.xy, vertex.attrib[8], 0.000030518;
MOV _texCoordAttrib.zw, 1;
#replace normalAttrib with _normalAttrib
TEMP _normalAttrib;
TEMP _attribTemp;
MUL _normalAttrib, vertex.attrib[2], 0.000030518;
MUL _attribTemp.xy, _normalAttrib, _normalAttrib;
ADD _attribTemp.x, _attribTemp.xxxx, _attribTemp.yyyy;
ADD _attribTemp.x, 1, -_attribTemp.x;
RSQ _attribTemp.x, _attribTemp.x;
RCP _normalAttrib.z, _attribTemp.x;
ADD _attribTemp.x, $signAttrib$.x, -1;
MUL _normalAttrib.z, _normalAttrib.z, _attribTemp.x;


TEMP	R0, R1;

# masks have a scale and offset
# Store each texture coordinate into its individual array
MAD		result.texcoord[0].xy, _texCoordAttrib.xyxy, program.local[0].w, program.local[0].xyxy;
MAD		result.texcoord[0].zw, _texCoordAttrib.xyxy, program.local[1].w, program.local[1].xyxy;

	MAD		result.texcoord[1].xy, _texCoordAttrib.xyxy, program.local[2].w, program.local[2].xyxy;


	MAD		result.texcoord[1].zw, _texCoordAttrib.xyxy, program.local[3].w, program.local[3].xyxy;



SUB result.texcoord[3], program.local[4], vertex.position;
SUB result.texcoord[4], program.local[5], vertex.position;

MOV result.texcoord[5], _normalAttrib;

# images just have a scale
MOV		result.texcoord[7], _texCoordAttrib;


TEMP	_DTLR0;
SUB		_DTLR0, _texCoordAttrib.xyxy, 0.5;
MUL		result.texcoord[7].zw, _DTLR0, program.local[6].x;



DP4		R0.x, vertex.position, program.local[7];
DP4		R0.y, vertex.position, program.local[8];
DP4		R0.z, vertex.position, program.local[9];
DP4		R0.w, vertex.position, program.local[10];
MOV		result.texcoord[6], R0;

# calculate vector to light in R0 (object space)
SUB		R0, program.local[4], vertex.position;
DP3		R1, R0, R0;
RSQ		R1, R1.x;
MUL		R0, R0, R1.x;

DP3		R0, _normalAttrib, R0;
MAX		R0, R0, 0;
ADD		R1, 1, -R0;
MAD		result.color, program.local[11].x, R1, R0;

TEMP _R1, _R2;
SUB		_R2, vertex.position, program.local[5];
DP3		_R1.x, _R2, _R2;
RSQ		_R1.y, _R1.x;
MUL		_R1.x, _R1.y, _R1.x;
MUL		_R1.x, _R1.x, 0.00002;
#EX2		result.texcoord[3], -R1.x;
SUB		result.color.secondary, 1, _R1.x;

	
END
