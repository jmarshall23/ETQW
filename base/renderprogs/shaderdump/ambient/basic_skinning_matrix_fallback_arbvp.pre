!!ARBvp1.0
#replace normalAttrib with _normalAttrib
TEMP _normalAttrib;
TEMP _attribTemp;
MUL _normalAttrib, vertex.attrib[2], 0.000030518;
MUL _attribTemp.xy, _normalAttrib, _normalAttrib;
ADD _attribTemp.x, _attribTemp.xxxx, _attribTemp.yyyy;
ADD _attribTemp.x, 1, -_attribTemp.x;
RSQ _attribTemp.x, _attribTemp.x;
RCP _normalAttrib.z, _attribTemp.x;
ADD _attribTemp.x, $signAttrib$.x, -1;
MUL _normalAttrib.z, _normalAttrib.z, _attribTemp.x;
#replace texCoordAttrib with _texCoordAttrib
TEMP _texCoordAttrib;
MUL _texCoordAttrib.xy, vertex.attrib[8], 0.000244141;
MOV _texCoordAttrib.zw, 1;

		TEMP	bitangent;
TEMP	R0, R1, R2, position, _nrm;


		ATTRIB	_jointIndices = vertex.attrib[10];
		ATTRIB	_jointWeights = vertex.attrib[11];
		
		PARAM	_joints[210] = { program.env[32..241] };	# 74 joints
		PARAM	_mvp[4] = { state.matrix.mvp };

		ADDRESS	_A0;
		TEMP	_R0, _R1, _R2;

		# accumulate weighted joint matrices
		ARL		_A0.x, _jointIndices.x;
		MUL		_R0, _joints[_A0.x+0], _jointWeights.x;
		MUL		_R1, _joints[_A0.x+1], _jointWeights.x;
		MUL		_R2, _joints[_A0.x+2], _jointWeights.x;
		ARL		_A0.x, _jointIndices.y;
		MAD		_R0, _joints[_A0.x+0], _jointWeights.y, _R0;
		MAD		_R1, _joints[_A0.x+1], _jointWeights.y, _R1;
		MAD		_R2, _joints[_A0.x+2], _jointWeights.y, _R2;
		ARL		_A0.x, _jointIndices.z;
		MAD		_R0, _joints[_A0.x+0], _jointWeights.z, _R0;
		MAD		_R1, _joints[_A0.x+1], _jointWeights.z, _R1;
		MAD		_R2, _joints[_A0.x+2], _jointWeights.z, _R2;
		ARL		_A0.x, _jointIndices.w;
		MAD		_R0, _joints[_A0.x+0], _jointWeights.w, _R0;
		MAD		_R1, _joints[_A0.x+1], _jointWeights.w, _R1;
		MAD		_R2, _joints[_A0.x+2], _jointWeights.w, _R2;

		
		
		# transform vertex
		DP4		position.x, _R0, vertex.position;
		DP4		position.y, _R1, vertex.position;
		DP4		position.z, _R2, vertex.position;
		MOV		position.w, 1;

		DP4		result.position.x, _mvp[0], position;
		DP4		result.position.y, _mvp[1], position;
		DP4		result.position.z, _mvp[2], position;
		DP4		result.position.w, _mvp[3], position;
	

				# transform normal
				DP3		_nrm.x, _R0, _normalAttrib;
				DP3		_nrm.y, _R1, _normalAttrib;
				DP3		_nrm.z, _R2, _normalAttrib;
			

PARAM	defaultTexCoord = { 0, 0.5, 0, 1 };

# textures 4 takes the base coordinates by the texture matrix
MOV		result.texcoord[4], defaultTexCoord;
DP4		result.texcoord[4].x, _texCoordAttrib, program.local[0];
DP4		result.texcoord[4].y, _texCoordAttrib, program.local[1];

# generate the vertex color, which can be 1.0, color, or 1.0 - color
MAD		result.color, vertex.attrib[3], program.local[2], program.local[3];

DP3		result.texcoord[5].x, program.local[4], _nrm;
DP3		result.texcoord[5].y, program.local[5], _nrm;
DP3		result.texcoord[5].z, program.local[6], _nrm;


SUB		R2, position, program.local[7];
DP3		R1.x, R2, R2;
RSQ		R1.y, R1.x;
MUL		R1.x, R1.y, R1.x;
MAD		result.color.secondary, R1.x, program.local[8].z, program.local[8].w; 


	
END
