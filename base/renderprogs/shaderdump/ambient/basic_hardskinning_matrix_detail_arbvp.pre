!!ARBvp1.0
#replace normalAttrib with _normalAttrib
TEMP _normalAttrib;
TEMP _attribTemp;
MUL _normalAttrib, vertex.attrib[2], 0.000030518;
MUL _attribTemp.xy, _normalAttrib, _normalAttrib;
ADD _attribTemp.x, _attribTemp.xxxx, _attribTemp.yyyy;
ADD _attribTemp.x, 1, -_attribTemp.x;
RSQ _attribTemp.x, _attribTemp.x;
RCP _normalAttrib.z, _attribTemp.x;
ADD _attribTemp.x, $signAttrib$.x, -1;
MUL _normalAttrib.z, _normalAttrib.z, _attribTemp.x;
#replace tangentAttrib with _tangentAttrib
TEMP _tangentAttrib;
MUL _tangentAttrib, vertex.attrib[9], 0.000030518;
MUL _attribTemp.xy, _tangentAttrib, _tangentAttrib;
ADD _attribTemp.x, _attribTemp.xxxx, _attribTemp.yyyy;
ADD _attribTemp.x, 1, -_attribTemp.x;
RSQ _attribTemp.x, _attribTemp.x;
RCP _tangentAttrib.z, _attribTemp.x;
ADD _attribTemp.x, $signAttrib$.y, -1;
MUL _tangentAttrib.z, _tangentAttrib.z, _attribTemp.x;
ADD _tangentAttrib.w, $signAttrib$.z, -1;
#replace texCoordAttrib with _texCoordAttrib
TEMP _texCoordAttrib;
MUL _texCoordAttrib.xy, vertex.attrib[8], 0.000244141;
MOV _texCoordAttrib.zw, 1;

		
		TEMP	position, normal, tangent, bitangent;
TEMP	R0, R1, R2;

PARAM	defaultTexCoord = { 0, 0.5, 0, 1 };


		ATTRIB	_jointIndices = vertex.attrib[12];
		
		PARAM	_joints[210] = { program.env[32..241] };	# 74 joints
		PARAM	_mvp[4] = { state.matrix.mvp };

		ADDRESS	_A0;
		TEMP	_R0, _R1, _R2;

		# accumulate weighted joint matrices
		ARL		_A0.x, _jointIndices.w;
		MOV		_R0, _joints[_A0.x+0];
		MOV		_R1, _joints[_A0.x+1];
		MOV		_R2, _joints[_A0.x+2];
		
		# transform vertex
		DP4		position.x, _R0, vertex.position;
		DP4		position.y, _R1, vertex.position;
		DP4		position.z, _R2, vertex.position;
		MOV		position.w, 1;

		DP4		result.position.x, _mvp[0], position;
		DP4		result.position.y, _mvp[1], position;
		DP4		result.position.z, _mvp[2], position;
		DP4		result.position.w, _mvp[3], position;
	

				# transform normal
				DP3		normal.x, _R0, _normalAttrib;
				DP3		normal.y, _R1, _normalAttrib;
				DP3		normal.z, _R2, _normalAttrib;
			

				# transform tangent
				DP3		tangent.x, _R0, _tangentAttrib;
				DP3		tangent.y, _R1, _tangentAttrib;
				DP3		tangent.z, _R2, _tangentAttrib;
			

				# derive bitangent
				XPD		bitangent, normal, tangent;
				MUL		bitangent, bitangent, _tangentAttrib.w;
			

# textures 1 takes the base coordinates by the texture matrix
MOV		result.texcoord[1], defaultTexCoord;
DP4		result.texcoord[1].x, _texCoordAttrib, program.local[0];
DP4		result.texcoord[1].y, _texCoordAttrib, program.local[1];

# textures 4 takes the base coordinates by the texture matrix
MOV		result.texcoord[4], defaultTexCoord;
DP4		result.texcoord[4].x, _texCoordAttrib, program.local[2];
DP4		result.texcoord[4].y, _texCoordAttrib, program.local[3];

# generate the vertex color, which can be 1.0, color, or 1.0 - color
MAD		result.color, vertex.attrib[3], program.local[4], program.local[5];

# build tangent space -> world space conversion matrix
DP3		result.texcoord[5].x, program.local[6], tangent;
DP3		result.texcoord[6].x, program.local[7], tangent;
DP3		result.texcoord[7].x, program.local[8], tangent;

DP3		result.texcoord[5].y, program.local[6], bitangent;
DP3		result.texcoord[6].y, program.local[7], bitangent;
DP3		result.texcoord[7].y, program.local[8], bitangent;

DP3		result.texcoord[5].z, program.local[6], normal;
DP3		result.texcoord[6].z, program.local[7], normal;
DP3		result.texcoord[7].z, program.local[8], normal;

# calculate vector to eye
DP4		R0.x, program.local[6], position;
DP4		R0.y, program.local[7], position;
DP4		R0.z, program.local[8], position;

# normalize
#TEMP	viewtovec;
SUB		R1.xyz, R0, program.local[9];
DP3		R1.w, R1, R1;
RSQ		R0.w, R1.w;
MUL		result.texcoord[2], R1, -R0.w;



#ifdef enable_detail_fade
PARAM  mv[4]       = { state.matrix.modelview };
DP4   R0.w, -mv[2], position;
SUB   R0.w, R0.w, program.local[10].x;
MAD result.texcoord[1].w, R0.w, program.local[10].y, 1;
#endif


SUB		R2, position, program.local[11];
DP3		R1.x, R2, R2;
RSQ		R1.y, R1.x;
MUL		R1.x, R1.y, R1.x;
MAD		result.color.secondary, R1.x, program.local[12].z, program.local[12].w; 


	
END
